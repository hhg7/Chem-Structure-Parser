# Anything below is produced by `perl Makefile.PL && make` and can be rebuilt
# from what is tracked, so it does not belong in the history.  These are the
# same files MANIFEST.SKIP keeps out of a release.

# XS build products
Parser.c
Parser.bs
*.o
*.a
*.so
*.dylib
*.dll
Parser.def

# ExtUtils::MakeMaker
Makefile
Makefile.old
MYMETA.json
MYMETA.yml
pm_to_blib
blibdirs
blib/

# md2pod.pl, which writes it beside the POD half of lib/Chem/Structure/Parser.pm
read.me.pod

# Dist::Zilla
.build/
Chem-Structure-Parser-*/
Chem-Structure-Parser-*.tar.gz

# Coverage.  `cover -t' leaves cover_db/ behind, and a build with
# -fprofile-arcs -ftest-coverage leaves a .gcno beside every object, a .gcda
# beside every run and a .gcov for every header gcov walked into.
cover_db/
*.gcov
*.gcda
*.gcno
